{
  "manifest_version": 3,
  "name": "Click Coordinate Tracker",
  "version": "1.0.0",
  "description": "Captures browser click coordinates and page information.",
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
